{
  "name": "booking-saas-week01",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant SaaS starter (MERN) — shared-collection tenancy with AsyncLocalStorage scoping",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "sync:indexes": "npm run sync:indexes --workspace server",
    "stripe:setup": "npm run stripe:setup --workspace server",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace server",
    "test:client": "npm run test --workspace client",
    "verify:isolation": "npm run verify:isolation --workspace server",
    "verify:bookings": "npm run verify:bookings --workspace server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "npm run build --workspace client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
