          },
          "response": [
            {
              "name": "400 VALIDATION_ERROR",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": { "mode": "raw", "raw": "{}" },
                "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "cookie": [],
              "body": "{\n  \"error\": {\n    \"code\": \"VALIDATION_ERROR\",\n    \"message\": \"The request failed validation.\",\n    \"details\": [\n      { \"path\": \"body.customerName\", \"message\": \"Customer name is required\" },\n      { \"path\": \"body.customerEmail\", \"message\": \"Enter a valid email address\" },\n      { \"path\": \"body.startAt\", \"message\": \"Start must fall on a 5-minute boundary\" },\n      { \"path\": \"body.endAt\", \"message\": \"End must be after start\" },\n      { \"path\": \"body.startAt\", \"message\": \"Must be in the future\" }\n    ],\n    \"requestId\": \"req_mdx8p2k1a3f9c7e5\"\n  }\n}"
