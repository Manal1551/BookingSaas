    {
      "name": "Idempotency demo",
      "description": "Run these in order. They share a pinned key so the replay is observable.",
      "item": [
        {
          "name": "1 — Create with a pinned key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pin ONE key for this demo folder, overriding the collection script.",
                  "const uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {",
                  "  const r = (Math.random() * 16) | 0;",
                  "  const v = c === 'x' ? r : ((r & 0x3) | 0x8);",
                  "  return v.toString(16);",
                  "});",
                  "pm.collectionVariables.set('replayKey', uuid);",
                  "// Pin the window too, so request #2 is byte-identical.",
                  "const start = new Date(Date.now() + 48 * 60 * 60 * 1000);",
                  "start.setUTCSeconds(0, 0);",
                  "start.setUTCMinutes(Math.ceil(start.getUTCMinutes() / 5) * 5);",
                  "pm.collectionVariables.set('startAt', start.toISOString());",
                  "pm.collectionVariables.set('endAt', new Date(start.getTime() + 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 on first call', () => pm.response.to.have.status(201));",
                  "pm.test('not a replay', () => pm.expect(pm.response.headers.get('Idempotent-Replay')).to.be.oneOf([null, undefined]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "{{replayKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Grace Hopper\",\n  \"customerEmail\": \"grace@example.com\",\n  \"serviceName\": \"Compiler review\",\n  \"resourceId\": \"lab-2\",\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          },
          "response": []
        },
        {
          "name": "2 — Replay: same key, same body",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["// Reuse replayKey/startAt/endAt from step 1 — do not regenerate."] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replays the original status', () => pm.response.to.have.status(201));",
                  "pm.test('flagged as a replay', () => pm.expect(pm.response.headers.get('Idempotent-Replay')).to.eql('true'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "{{replayKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Grace Hopper\",\n  \"customerEmail\": \"grace@example.com\",\n  \"serviceName\": \"Compiler review\",\n  \"resourceId\": \"lab-2\",\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            },
            "description": "Identical to step 1. The stored response comes back verbatim — no second booking is created."
          },
          "response": [
            {
              "name": "201 replayed",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": { "mode": "raw", "raw": "{}" },
                "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json; charset=utf-8" },
                { "key": "Idempotent-Replay", "value": "true" },
                { "key": "X-Request-Id", "value": "req_mdx8p2k1a3f9c7e3" }
              ],
              "cookie": [],
              "body": "{\n  \"booking\": {\n    \"id\": \"665f1c2a9b1e4d3f2a7c8b01\",\n    \"customerName\": \"Grace Hopper\",\n    \"customerEmail\": \"grace@example.com\",\n    \"serviceName\": \"Compiler review\",\n    \"resourceId\": \"lab-2\",\n    \"startAt\": \"2026-08-01T10:00:00.000Z\",\n    \"endAt\": \"2026-08-01T11:00:00.000Z\",\n    \"notes\": \"\",\n    \"status\": \"pending\",\n    \"version\": 0,\n    \"createdAt\": \"2026-07-27T09:12:44.001Z\",\n    \"updatedAt\": \"2026-07-27T09:12:44.001Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "3 — Reuse: same key, DIFFERENT body",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["// Still using replayKey from step 1."] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));",
                  "pm.test('IDEMPOTENCY_KEY_REUSE', () => pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_KEY_REUSE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "{{replayKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Someone Else\",\n  \"customerEmail\": \"else@example.com\",\n  \"serviceName\": \"Compiler review\",\n  \"resourceId\": \"lab-2\",\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          },
          "response": [
            {
              "name": "409 IDEMPOTENCY_KEY_REUSE",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": { "mode": "raw", "raw": "{}" },
                "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "cookie": [],
              "body": "{\n  \"error\": {\n    \"code\": \"IDEMPOTENCY_KEY_REUSE\",\n    \"message\": \"This Idempotency-Key was already used with a different request body. Generate a new key for a new booking.\",\n    \"requestId\": \"req_mdx8p2k1a3f9c7e4\"\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Failure modes",
      "item": [
        {
          "name": "400 — validation error",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
