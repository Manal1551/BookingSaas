# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
NODE_ENV=development
PORT=5000

# Either a local Dockerized Mongo (matches docker-compose.yml):
#   mongodb://root:example@localhost:27017/saas?authSource=admin
# Or an Atlas SRV string:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/saas
MONGODB_URI=mongodb://root:example@localhost:27017/saas?authSource=admin

# Generate strong random secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# These MUST be different from each other.
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret-min-32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# The bare root domain. Subdomains of this become tenant slugs.
ROOT_DOMAIN=app.local

# CORS: allowed browser origin pattern. `*` inside the host is treated as a
# subdomain wildcard (any tenant subdomain on the dev port).
CLIENT_ORIGIN_PATTERN=http://*.app.local:5173
