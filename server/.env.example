# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
NODE_ENV=development
PORT=5000

# Either a local Dockerized Mongo (matches docker-compose.yml):
#   mongodb://root:example@localhost:27017/saas?authSource=admin
# Or an Atlas SRV string:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/saas
MONGODB_URI=mongodb://root:example@localhost:27017/saas?authSource=admin

# Generate strong random secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# These MUST be different from each other.
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret-min-32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# The bare root domain. Subdomains of this become tenant slugs.
ROOT_DOMAIN=app.local

# CORS: allowed browser origin pattern. `*` inside the host is treated as a
# subdomain wildcard (any tenant subdomain on the dev port).
CLIENT_ORIGIN_PATTERN=http://*.app.local:5173

# ---------------------------------------------------------------------------
# Stripe billing (Week 3)
#
# ALL of these are optional. Leave them blank and the app still boots and runs
# — the billing routes answer 503 BILLING_NOT_CONFIGURED and the pricing page
# renders in a read-only state. Fill them in to switch billing on.
# ---------------------------------------------------------------------------

# Test-mode secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint. Two ways to get one:
#   local dev:  stripe listen --forward-to localhost:5000/api/webhooks/stripe
#               (the CLI prints a whsec_... to paste here)
#   deployed:   Dashboard > Developers > Webhooks > your endpoint > signing secret
# Without this, the webhook endpoint refuses every event with 503 — it will not
# process an event it cannot verify.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_...) for each cell of the pricing table. Create a Product
# per plan with a monthly and a yearly recurring price. A blank entry makes
# that plan render as unavailable rather than failing at checkout.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Where Stripe Checkout / the Billing Portal return the browser. `{slug}` is
# replaced with the tenant's subdomain so each workspace lands back on its own.
BILLING_RETURN_URL=http://{slug}.app.local:5173/dashboard/billing

# Max age (seconds) of a signed webhook payload. Bounds replay of a captured
# request; 300 is Stripe's own default and rarely needs changing.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
